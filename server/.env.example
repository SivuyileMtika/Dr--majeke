PORT=3000

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_token
WHATSAPP_PHONE_NUMBER_ID=862463110291217
WHATSAPP_BUSINESS_ACCOUNT_ID=1216317630412746
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token
WHATSAPP_APP_SECRET=your_app_secret_from_app_settings_basic

# Firebase
FIREBASE_SERVICE_ACCOUNT=/path/to/serviceAccountKey.json

# Doctor dashboard auth
DOCTOR_AUTH_TOKEN=your-secure-doctor-token-min-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
WEBHOOK_URL=https://dr-majeke-production.up.railway.app/webhook

# WhatsApp Flows
FLOW_ID=your_flow_id_from_whatsapp_manager
FLOW_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMII...\n-----END RSA PRIVATE KEY-----

# n8n Integration (optional — leave blank to disable)
# Paste the Production URL of the "New Appointment Alert" webhook in n8n here
N8N_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/majeke-new-booking
# Doctor WhatsApp number in international format without + (e.g. 27834289828)
DOCTOR_PHONE=27834289828
