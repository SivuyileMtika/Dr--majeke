rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Appointments — dashboard reads directly via client SDK.
    // Requires a signed-in Firebase Auth account carrying the `doctor`
    // custom claim (set only via the Admin SDK when the account is
    // provisioned) — `request.auth != null` alone isn't enough, since
    // Firebase's public signUp endpoint lets anyone create an
    // authenticated-but-unprivileged session.
    match /appointments/{apptId} {
      allow read: if request.auth != null && request.auth.token.doctor == true;
      allow write: if false; // only server (Admin SDK) writes
    }

    // Conversation state — server only
    match /patient_conversations/{phone} {
      allow read, write: if false;
    }

    // Time slots — server only
    match /time_slots/{slotId} {
      allow read: if true;
      allow write: if false;
    }

    // Services & medical aids — public read
    match /services/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /medical_aids/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else — deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
